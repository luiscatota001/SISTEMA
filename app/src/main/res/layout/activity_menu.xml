<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textStyle="bold"
        android:textSize="24sp"/>

    <TextView
        android:id="@+id/txtUnidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unidad"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"/>

    <!-- Resumen del día -->

    <TextView
        android:id="@+id/txtHoraIngreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hora ingreso: --"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/txtActividades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actividades hoy: 0"/>

    <TextView
        android:id="@+id/txtSupervisiones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Supervisiones hoy: 0"
        android:layout_marginBottom="25dp"/>

    <!-- Acciones -->

    <Button
        android:id="@+id/btnAsistencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Asistencia"/>

    <Button
        android:id="@+id/btnRegistroActividades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registro de Actividades"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnSupervisionOperativa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Supervisión Operativa"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesión"
        android:layout_marginTop="25dp"/>

</LinearLayout>